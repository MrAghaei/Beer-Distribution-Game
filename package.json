{
  "name": "beer-game",
  "version": "0.0.0",
  "private": true,
  "description": "Take-home task: a small multiplayer supply-chain game.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start -w @beer/server",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
